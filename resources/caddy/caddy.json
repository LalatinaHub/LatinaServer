{
  "apps": {
    "layer4": {
      "servers": {
        "gate": {
          "listen": ["0.0.0.0:443"],
          "routes": [
            {
              "handle": [
                {
                  "handler": "tls",
                  "connection_policies": [{ "default_sni": "DOMAIN", "fallback_sni": "DOMAIN" }]
                },
                { "handler": "proxy", "upstreams": [{ "dial": ["localhost:80"] }] }
              ]
            }
          ]
        },
        "srv0": {
          "listen": ["0.0.0.0:80"],
          "routes": [
            {
              "match": [
                {
                  "regexp": {
                    "count": 58,
                    "pattern": "\\x0d\\x0a$"
                  }
                }
              ],
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:TROJAN_TCP_PORT"] }] }]
            },
            {
              "match": [
                {
                  "regexp": {
                    "count": 1,
                    "pattern": "\\x00"
                  }
                }
              ],
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:VLESS_TCP_PORT"] }] }]
            },
            {
              "match": [
                {
                  "http": []
                }
              ],
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:CADDY_PORT"] }] }]
            },
            {
              "match": [
                {
                  "regexp": {
                    "count": 3,
                    "pattern": "PRI"
                  }
                }
              ],
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:CADDY_PORT"] }] }]
            },
            {
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:VMESS_TCP_PORT"] }] }]
            }
          ]
        }
      }
    },
    "http": {
      "servers": {
        "srv0": {
          "listen": [":CADDY_PORT"],
          "protocols": ["h1", "h2", "h2c", "h3"],
          "routes": [
            {
              "match": [{ "path": ["/trojan"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:TROJAN_WS_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/trojan"], "header": { "Sec-Websocket-Key": null } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:TROJAN_HU_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/trojan/Tun"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "localhost:TROJAN_GRPC_PORT" }],
                  "transport": {
                    "protocol": "http",
                    "versions": ["h2c"]
                  }
                }
              ],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vmess"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VMESS_WS_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vmess"], "header": { "Sec-Websocket-Key": null } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VMESS_HU_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vmess/Tun"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "localhost:VMESS_GRPC_PORT" }],
                  "transport": {
                    "protocol": "http",
                    "versions": ["h2c"]
                  }
                }
              ],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vless"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VLESS_WS_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vless"], "header": { "Sec-Websocket-Key": null } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VLESS_HU_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vless/Tun"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "localhost:VLESS_GRPC_PORT" }],
                  "transport": {
                    "protocol": "http",
                    "versions": ["h2c"]
                  }
                }
              ],
              "terminal": true
            },
            {
              "match": [{ "path_regexp": { "pattern": "/yacd/*" } }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "localhost:9090" }],
                  "rewrite": { "strip_path_prefix": "/yacd" }
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "path": ["/", "/ping"]
                }
              ],
              "handle": [{ "handler": "static_response", "body": "Welcome to Caddy!" }]
            },
            {
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:WEBSERVER_PORT" }] }],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "certificates": {
        "automate": ["DOMAIN"]
      },
      "automation": {
        "policies": [
          {
            "subjects": ["DOMAIN"],
            "issuers": [
              {
                "module": "acme",
                "email": "EMAIL",
                "challenges": {
                  "dns": {
                    "provider": {
                      "name": "cloudflare",
                      "api_token": "CF_KEY"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "logging": { "logs": { "default": { "level": "INFO" }, "writer": { "output": "file", "filename": "CADDY_LOGFILE" } } }
}
