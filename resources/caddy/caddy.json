{
  "apps": {
    "layer4": {
      "servers": {
        "gate": {
          "listen": ["0.0.0.0:443"],
          "routes": [
            {
              "handle": [
                {
                  "handler": "tls",
                  "connection_policies": [{ "default_sni": "DOMAIN", "fallback_sni": "DOMAIN" }]
                },
                { "handler": "proxy", "upstreams": [{ "dial": ["localhost:80"] }] }
              ]
            }
          ]
        },
        "srv0": {
          "listen": ["0.0.0.0:80"],
          "routes": [
            {
              "match": [
                {
                  "regexp": {
                    "count": 58,
                    "pattern": "^[0-9a-fA-F].*\\x0d\\x0a$"
                  }
                }
              ],
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:TROJAN_TCP_PORT"] }] }]
            },
            {
              "match": [
                {
                  "regexp": {
                    "count": 1,
                    "pattern": "\\x00"
                  }
                }
              ],
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:VLESS_TCP_PORT"] }] }]
            },
            {
              "match": [
                {
                  "regexp": {
                    "count": 4,
                    "pattern": "^(GET |POST|HEAD|PUT |DELE|OPTI|PATC|PRI )"
                  }
                }
              ],
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:CADDY_PORT"] }] }]
            },
            {
              "handle": [{ "handler": "proxy", "upstreams": [{ "dial": ["localhost:VMESS_TCP_PORT"] }] }]
            }
          ]
        }
      }
    },
    "http": {
      "servers": {
        "srv0": {
          "listen": [":CADDY_PORT"],
          "protocols": ["h1", "h2", "h2c", "h3"],
          "routes": [
            {
              "match": [{ "path": ["/trojan", "/trojan/"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:TROJAN_WS_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/trojan", "/trojan/"], "header": { "Upgrade": ["*"], "Sec-Websocket-Key": null } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:TROJAN_HU_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/trojan/Tun", "/trojan/Tun/*"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "localhost:TROJAN_GRPC_PORT" }],
                  "transport": {
                    "protocol": "http",
                    "versions": ["h2c"]
                  }
                }
              ],
              "terminal": true
            },
            {
              "match": [{ "path": ["/trojan-udp", "/trojan-udp/"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:TROJAN_UDP_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vless-udp", "/vless-udp/"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VLESS_UDP_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vmess-udp", "/vmess-udp/"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VMESS_UDP_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vmess", "/vmess/"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VMESS_WS_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vmess", "/vmess/"], "header": { "Upgrade": ["*"], "Sec-Websocket-Key": null } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VMESS_HU_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vmess/Tun", "/vmess/Tun/*"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "localhost:VMESS_GRPC_PORT" }],
                  "transport": {
                    "protocol": "http",
                    "versions": ["h2c"]
                  }
                }
              ],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vless", "/vless/"], "header": { "Sec-Websocket-Key": ["*"] } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VLESS_WS_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vless", "/vless/"], "header": { "Upgrade": ["*"], "Sec-Websocket-Key": null } }],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:VLESS_HU_PORT" }] }],
              "terminal": true
            },
            {
              "match": [{ "path": ["/vless/Tun", "/vless/Tun/*"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "localhost:VLESS_GRPC_PORT" }],
                  "transport": {
                    "protocol": "http",
                    "versions": ["h2c"]
                  }
                }
              ],
              "terminal": true
            },
            {
              "match": [{ "path_regexp": { "pattern": "/yacd/*" } }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "localhost:9090" }],
                  "rewrite": { "strip_path_prefix": "/yacd" }
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "path": [
                    "/",
                    "/portal",
                    "/portal/*",
                    "/posts",
                    "/posts/*",
                    "/records",
                    "/records/*",
                    "/about",
                    "/about/*",
                    "/css/*",
                    "/js/*",
                    "/fonts/*",
                    "/images/*",
                    "/dashboard",
                    "/dashboard/*"
                  ]
                }
              ],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:WEBSERVER_PORT" }] }],
              "terminal": true
            },
            {
              "match": [
                {
                  "path_regexp": {
                    "pattern": "/api/v1/*"
                  }
                }
              ],
              "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "localhost:WEBSERVER_PORT" }] }],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "localhost:WEBSERVER_PORT"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "certificates": {
        "automate": ["DOMAIN_LIST"]
      },
      "automation": {
        "policies": [
          {
            "subjects": ["DOMAIN_LIST"],
            "issuers": [
              {
                "module": "acme",
                "email": "EMAIL",
                "challenges": {
                  "dns": {
                    "provider": {
                      "name": "cloudflare",
                      "api_token": "CF_KEY"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "logging": { "logs": { "default": { "level": "INFO" } } }
}
